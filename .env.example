# AWAKEN. - Environment Variable Template
# Copy this file to .env.local and replace the values with your Supabase credentials.

# Your Supabase Project URL (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Public Key (Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5c...

# Your Supabase Service Role Key (Required for secure backend operations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5c...
